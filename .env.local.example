# =====================================================
# انسخ هذا الملف واسمه .env.local واملأ القيم
# =====================================================

# MongoDB — من mongodb.com/atlas
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority"

# JWT — أي نص عشوائي طويل (32+ حرف)
JWT_SECRET="replace-this-with-a-very-long-random-secret-string-minimum-32-chars"
JWT_EXPIRES_IN="7d"

# URL المشروع
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail — من: myaccount.google.com > Security > App Passwords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="your@gmail.com"

# Stripe — من: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# VAPID — شغّل: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="your@gmail.com"
